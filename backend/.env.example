# Never commit real secrets. Copy to backend/.env locally.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/indifolks
JWT_SECRET=replace-with-a-long-unique-random-secret-at-least-32-chars
CLIENT_ORIGINS=http://localhost:8080,http://localhost:5173,https://abhinay120906.github.io
# Optional: for hosted artist profile/gallery uploads (Render file storage is ephemeral)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set true ONLY for a non-commercial thesis demo: no real payments are collected.
ENABLE_DEMO_PAYMENTS=false
# Razorpay TEST credentials (not live). Never use VITE_ for secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Only used by the local create-admin script. Do not set in frontend.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=IndiFolks Admin
